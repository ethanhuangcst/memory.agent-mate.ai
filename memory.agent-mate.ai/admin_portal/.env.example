# 门户环境文件 —— 样例（复制为 .env 后填值；.env 已在仓库根 .gitignore 中忽略）
#
# 存放位置：
#   服务器：/opt/ai-memory/portal.env（chmod 600，与主 stack 分离，见 deploy/portal.env.example）
#   本机开发：admin_portal/.env（真身份 / 隧道路径）与 admin_portal/.env.local（回环快速路径）
#   两者均已忽略；用法与两条路径的差异见 admin_portal/README.md「本机两条测试路径」
#
# 纪律：本文件只列键名与语义，**不写任何真实值**（ADR-006 公开仓脱敏纪律）。
# 键名与语义真源：specs/web-portal/web-design.md §12.9。

# ---- 面隔离（必填；面判定按 Host 头，仅比对主机名、忽略端口）----
# 生产：各填一个真实域名。本机开发：可填逗号分隔的多个（如 localhost,127.0.0.1）。
PORTAL_ADMIN_HOST=
PORTAL_MCP_HOST=

# ---- 门户库（必填；必须不在 /data 下，见 AC9.1 / AC9.4）----
PORTAL_DB_PATH=

# ---- 管理面认证：Cloudflare Access（必填）----
# 团队域（用于取 JWKS 与校验 iss），如 <team>.cloudflareaccess.com
PORTAL_ACCESS_TEAM_DOMAIN=
# Access 应用的 Audience 标签（校验 aud）
PORTAL_ACCESS_AUD=

# ---- 运行环境（可选）----
# development | production。production 下禁用一切非 Access 身份来源（启动自检 fail-closed）。
PORTAL_ENV=development
# 监听端口与日志级别（development 常用 pretty 日志）
PORTAL_PORT=8788
PORTAL_LOG_LEVEL=info
# 默认语言（可选，默认 zh-CN）
PORTAL_I18N_DEFAULT=zh-CN

# ---- 本机路径覆盖（可选；容器内用默认值）----
# 用户数据根目录（生产为 /data/users）
PORTAL_USERS_ROOT=
# 静态资源根（默认 admin_portal/assets）
PORTAL_STATIC_ROOT=
# 模板根（默认 admin_portal/src/web/views）
PORTAL_VIEWS_ROOT=

# ---- 离线测试专用：自签 JWT（默认关闭；仅本机测试，生产必须保持 0）----
PORTAL_TEST_JWT_ENABLED=0
# 测试用 JWKS（本地文件路径或内联 JSON，含验证公钥；仅供测试，勿用真实密钥）
PORTAL_TEST_JWT_JWKS=
PORTAL_TEST_JWT_ISS=
PORTAL_TEST_JWT_AUD=

# ---- 后续批次键（PSP-W2 接入批次启用；本批登记但不使用）----
# PORTAL_LAUNCH_TEMPLATE=
# PORTAL_SESSION_IDLE_TIMEOUT=
# PORTAL_SESSION_MAX_DURATION=
# PORTAL_MAX_CONCURRENCY_PER_KEY=
# PORTAL_MAX_CONCURRENCY_GLOBAL=
# PORTAL_RESPONSE_MAX_BYTES=
# DASHSCOPE_API_KEY=
