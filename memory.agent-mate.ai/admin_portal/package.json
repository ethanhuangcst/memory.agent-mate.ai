{
  "name": "admin-portal",
  "version": "0.1.0",
  "private": true,
  "description": "memory.agent-mate.ai 门户（portal-web）—— 管理面与公开说明页。实现批次 PSP-W1 起。",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "migrate": "tsx src/web/db/migrate.ts",
