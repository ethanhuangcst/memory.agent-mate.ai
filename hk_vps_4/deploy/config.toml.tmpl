# ============================================================================
# ai-memory config 模板 — 复制为 config.toml 后填入真实值
# 容器内路径：/data/.config/ai-memory/config.toml（由 HOME=/data 推导）
#
# ⚠️ 内联密钥（api_key = "..."）会在解析期被拒绝 — 只能用 api_key_env / api_key_file
# ⚠️ <QWEN_BASE_URL> 是占位符，真实值见 hk_vps_4/secrets.local.hk_vps_4.md
#    （含 /compatible-mode/v1 路径）。真实主机名带 workspace 标识，属可探测信息，
#    公开仓中不得出现明文 —— make secret-check 会拦截。
#
# 本地已填真实值的副本：config.local.toml（gitignored）。两者结构必须保持同步，
# 唯一差别是「真实值 vs 占位符」。
# ============================================================================

schema_version = 2

# serve 守护进程的档位（serve 无 --tier 参数，只能从这里来）
tier = "smart"

db = "/data/ai-memory.db"

# ---------------------------------------------------------------------------
# [llm] — smart 档的整理能力后端
#
# backend = "qwen" 是官方一等别名（等价 dashscope），但它默认指向公网端点：
#   https://dashscope.aliyuncs.com/compatible-mode/v1
# 本项目用的是**私有 MaaS workspace**，必须显式覆盖 base_url —— 否则会打到公网
# 端点，而 workspace 级 key 在那里不通。
# ---------------------------------------------------------------------------
[llm]
backend     = "qwen"
model       = "qwen-plus"          # 主档（2026-09-20 实测 chat OK）
base_url    = "<QWEN_BASE_URL>"    # 私有 MaaS；占位符需替换为真实值
api_key_env = "DASHSCOPE_API_KEY"  # 环境变量名，不是 key 本身

# ---------------------------------------------------------------------------
# [llm.auto_tag] — 高频结构化调用（auto_tag / 查询扩展 / 矛盾检测）用更便宜的档
#
# ⚠️ 只写 model，不要写 backend！
#    写 backend = "ollama" 会在无 Ollama 的机器上把这三类功能全部打挂
#    （官方样例文档 CONFIG_SCHEMA.md 正是这个坑）。
#    省略 backend 时逐字段继承 [llm]。
# ---------------------------------------------------------------------------
[llm.auto_tag]
model = "qwen-turbo"

# ---------------------------------------------------------------------------
# [embeddings] — 必须显式指向 API（smart 档 preset 默认走 Ollama 的 Nomic）
#
# 以下三项均由 hk_vps_4/scripts/qwen-verify.sh 于 2026-09-20 实测确定：
#   model = "qwen3.7-text-embedding"  端点 /models 中真实存在，实测可用
#   dim   = 1024                      实测返回的向量长度
#   base_url                          与 [llm] 同一私有 MaaS 端点
#
# ⚠️ dim 必须显式填写且与模型实际输出维度一致：
#   - qwen 的 embedding 模型不在 KNOWN_EMBEDDING_DIMS 表内（表内只有 nomic /
#     mxbai / openai / gemini / granite 等），查不到即返回 None
#   - 不设 dim 会退回 tier preset 的 768（smart 档），与实际 1024 不符
#   - 不存在 AI_MEMORY_EMBED_DIM 环境变量，dim 只能写在这里
#   - dim 填 0 会被忽略（非正值）并静默回落 —— 曾经的 dim = 0 只是占位符，
#     绝不可原样上线
#   - 维度定下即绑定到已写入的向量；换模型必须重跑回填
#   - 同为 1024 维的 qwen3.7-text-embedding-flash 也不等于向量可比
# ---------------------------------------------------------------------------
[embeddings]
backend        = "qwen"
model          = "qwen3.7-text-embedding"
dim            = 1024
base_url       = "<QWEN_BASE_URL>"    # 私有 MaaS；占位符需替换为真实值
backfill_batch = 100

# ---------------------------------------------------------------------------
# 本部署不对外开放 HTTP，故不设置顶层 api_key。
# 未来开放 HTTP 时必须：此处设 api_key + 环境变量 AI_MEMORY_REQUIRE_API_KEY=1
# 认证头是 X-API-Key，不是 Authorization: Bearer。
# ---------------------------------------------------------------------------
