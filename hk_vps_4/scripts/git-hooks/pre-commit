#!/bin/sh
# =============================================================================
# pre-commit 钩子源码（入库于 hk_vps_4/scripts/git-hooks/pre-commit）
#
# 安装方式（显式动作，不修改 git config）：
#   make hooks-install
# 该命令把本文件复制到 .git/hooks/pre-commit 并加可执行位。
#
# 作用：提交前扫描暂存区（index）内容，若混入公网 IPv4 则非零退出、阻止提交。
# 真实 IP 属于 gitignored 的 hk_vps_4/secrets.local.hk_vps_4.md，不应进仓。
#
# 纪律（与既有「只提醒、不强制」工作流一致）：可用 `git commit --no-verify`
# 绕过本钩子；护栏靠文档与评审而非强制。
# =============================================================================
set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
exec "$REPO_ROOT/hk_vps_4/scripts/secret-check.sh" --staged
